<Window x:Class="SysWatt.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="clr-namespace:SysWatt.App.Controls"
        Title="SysWatt — Power &amp; Energy Monitor" Width="1080" Height="780" MinWidth="850" MinHeight="600"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" ShowInTaskbar="True"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- TOP TOOLBAR -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="8,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="⚙  Settings" Click="Settings_Click" Margin="0,0,6,0" ToolTip="Open configuration options" />
          <Button Content="📊  Historical Energy Statistics…" Click="EnergyHistory_Click" Margin="0,0,6,0" ToolTip="Open daily and monthly energy records" />
          <Button Content="🛡  Restart as Administrator" Click="RestartElevated_Click" Margin="0,0,6,0"
                  Visibility="{Binding SensorAccessVisibility}" ToolTip="Gain direct hardware access for motherboard and fan telemetry" />
          <Button Content="{Binding ThemeAction}" Click="Theme_Click" Margin="0,0,6,0" ToolTip="Switch between Dark and Light mode" />
          <Button Content="ⓘ  About" Click="About_Click" ToolTip="SysWatt version and license" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
            <TextBlock Text="{Binding TelemetrySourceBadge}" Foreground="{DynamicResource AccentBrush}"
                       FontSize="11" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="{Binding UpdatedText}" Foreground="{DynamicResource MutedBrush}"
                     FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- MAIN SCROLLABLE CONTENT -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="10,8,10,12">
        <!-- Sensor Notice / Alert Banners -->
        <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8"
                Visibility="{Binding SensorAccessVisibility}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="HARDWARE SENSOR ACCESS" FontWeight="SemiBold" FontSize="11" />
              <TextBlock Text="{Binding SensorAccessNotice}" Foreground="{DynamicResource MutedBrush}"
                         FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Restart as administrator" Click="RestartElevated_Click"
                    VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>
        </Border>

        <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8"
                Visibility="{Binding AlertVisibility}">
          <TextBlock Text="{Binding ActiveAlert}" FontSize="11" FontWeight="SemiBold" />
        </Border>

        <!-- 1. POWER OVERVIEW -->
        <GroupBox Header="Live Power &amp; Component Telemetry">
          <UniformGrid Columns="4" Margin="2,4,2,4">
            <!-- Wall Power -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" CornerRadius="3" Padding="10,8" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="WALL POWER DRAW" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding SystemPower}" FontSize="26" FontWeight="Bold" Margin="0,4,0,1" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding DcPower, StringFormat=Internal DC: {0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding SystemPowerStatus}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SystemPowerStatus}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <!-- Board + Cooling + Storage -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" CornerRadius="3" Padding="10,8" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="STORAGE + COOLING + BOARD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding StorageCoolingBoardPower}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2" />
                <TextBlock Text="CALIBRATED HARDWARE MODEL" FontSize="10" Foreground="#E6A34A" FontWeight="SemiBold" />
                <TextBlock Text="Motherboard, memory, cooling, NVMe/SSD" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <!-- CPU Package -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" CornerRadius="3" Padding="10,8" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="CPU PACKAGE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                  <TextBlock Text="{Binding CpuPower}" FontSize="24" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CpuTemperature}" FontSize="15" Margin="10,6,0,0" Foreground="#3C91E6" />
                </StackPanel>
                <TextBlock Text="{Binding CpuUsage, StringFormat=Utilization: {0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Border>

            <!-- Today's Energy -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" CornerRadius="3" Padding="10,8">
              <StackPanel>
                <TextBlock Text="TODAY'S ENERGY DRAW" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding TodayEnergy}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="ACCUMULATED TODAY" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding EnergyMeasurementNotice}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </GroupBox>

        <!-- 2. POWER TREND -->
        <GroupBox Header="Wall Power Trend">
          <Grid Margin="2,4,2,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="180" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding GraphWindowLabel, StringFormat=Rolling window: {0}}" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
            <controls:TelemetryChart Grid.Row="1" Values="{Binding PowerHistory}"
                                     Stroke="{DynamicResource AccentBrush}" Unit=" W" Minimum="0" />
          </Grid>
        </GroupBox>

        <!-- 3. SYNCHRONIZED UTILIZATION & POWER -->
        <GroupBox Header="CPU &amp; GPU Performance Correlation">
          <Grid Margin="2,4,2,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" CornerRadius="3" Padding="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="160" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="CPU UTILIZATION &amp; POWER" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Text="Green: utilization % · Blue: package watts" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CpuUsage}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CpuPower}" FontSize="16" FontWeight="SemiBold" Foreground="#3C91E6" />
                  </StackPanel>
                </Grid>
                <controls:TelemetryChart Grid.Row="1" Values="{Binding CpuUsageHistory}" SecondaryValues="{Binding CpuPowerHistory}"
                                         Stroke="{DynamicResource AccentBrush}" SecondaryStroke="#3C91E6"
                                         Unit="%" SecondaryUnit=" W" Minimum="0" Maximum="100" SecondaryMinimum="0" />
              </Grid>
            </Border>

            <!-- GPU -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" CornerRadius="3" Padding="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="160" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="GPU UTILIZATION &amp; POWER" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Text="Purple: utilization % · Amber: board watts" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GpuUsage}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding GpuPower}" FontSize="16" FontWeight="SemiBold" Foreground="#E6A23C" />
                  </StackPanel>
                </Grid>
                <controls:TelemetryChart Grid.Row="1" Values="{Binding GpuUsageHistory}" SecondaryValues="{Binding GpuPowerHistory}"
                                         Stroke="#8B6FE8" SecondaryStroke="#E6A23C"
                                         Unit="%" SecondaryUnit=" W" Minimum="0" Maximum="100" SecondaryMinimum="0" />
              </Grid>
            </Border>
          </Grid>
        </GroupBox>

        <!-- 4. STORAGE & COOLING -->
        <Grid Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Storage -->
          <GroupBox Header="Storage Telemetry">
            <Grid Margin="2,4,2,4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <UniformGrid Columns="2" Rows="2" Margin="0,0,0,8">
                <StackPanel Margin="4,2">
                  <TextBlock Text="DISK ACTIVE TIME" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Text="{Binding StorageActivity}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="4,2">
                  <TextBlock Text="DEVICE POWER" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Text="{Binding StoragePower}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="4,2">
                  <TextBlock Text="READ RATE" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Text="{Binding StorageReadRate}" FontSize="16" />
                </StackPanel>
                <StackPanel Margin="4,2">
                  <TextBlock Text="WRITE RATE" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Text="{Binding StorageWriteRate}" FontSize="16" />
                </StackPanel>
              </UniformGrid>
              <controls:TelemetryChart Grid.Row="1" Height="100" Values="{Binding StorageActivityHistory}"
                                       Stroke="#3C91E6" Unit="%" Minimum="0" Maximum="100" />
            </Grid>
          </GroupBox>

          <!-- Cooling -->
          <GroupBox Grid.Column="2" Header="Cooling Headers &amp; Fan Speeds">
            <Grid Margin="2,4,2,4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding FanSummary}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <Button Content="{Binding ZeroRpmFanAction}" Command="{Binding ToggleZeroRpmFansCommand}"
                        Margin="8,0,0,0" ToolTip="Hide or show fan channels currently reporting 0 RPM" />
              </StackPanel>
              <ItemsControl Grid.Row="1" ItemsSource="{Binding Fans}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="65" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="2" Padding="4,1" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </GroupBox>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- STATUS BAR -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="8,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding TelemetrySourceDetails, StringFormat=Telemetry: {0}}"
                   FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="SysWatt · Background Telemetry Active"
                   FontSize="11" Foreground="{DynamicResource MutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
