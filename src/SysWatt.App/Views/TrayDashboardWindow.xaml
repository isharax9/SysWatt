<Window x:Class="SysWatt.App.Views.TrayDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysWatt.App.Controls"
        Title="SysWatt Quick Monitor" Width="390" Height="550" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Window.Resources>
    <!-- Native Pin Toggle Button -->
    <Style x:Key="NativePinButton" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="PinBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True"
                    Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📌" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock x:Name="PinLabel" Text="Pin" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PinBorder" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                <Setter TargetName="PinBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="PinLabel" Property="Text" Value="Pinned" />
                <Setter TargetName="PinLabel" Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PinBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Native Flyout Close Button -->
    <Style x:Key="FlyoutCloseButton" TargetType="Button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CloseBorder" Background="{TemplateBinding Background}" CornerRadius="3" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="8" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderStrongBrush}"
          BorderThickness="1" CornerRadius="4">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.30" ShadowDepth="3" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="34" />
        <RowDefinition Height="*" />
        <RowDefinition Height="42" />
      </Grid.RowDefinitions>

      <!-- TITLE / DRAG HEADER -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1" CornerRadius="4,4,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="10,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/SysWatt.App;component/Assets/SysWatt.ico" Width="16" Height="16" Margin="0,0,8,0" />
            <TextBlock Text="SysWatt Quick Monitor" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>

          <ToggleButton Grid.Column="1" IsChecked="{Binding TrayPopupPinned}" Style="{StaticResource NativePinButton}" Margin="0,0,4,0" />
          <Button Grid.Column="2" Content="✕" Style="{StaticResource FlyoutCloseButton}" Click="Close_Click" ToolTip="Close flyout" />
        </Grid>
      </Border>

      <!-- MAIN CONTENT -->
      <Grid Grid.Row="1" Margin="10,8,10,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- SECTION 1: LIVE POWER & ENERGY -->
        <GroupBox Header="Live Power &amp; Energy" Grid.Row="0" Margin="0,0,0,6">
          <Grid Margin="4,4,4,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Wall Draw -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="WALL DRAW" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{Binding SystemPower}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,1" />
              <TextBlock Text="{Binding InternalDcPower, StringFormat='Internal DC: {0}'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>

            <!-- Today's Energy -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="TODAY'S ENERGY" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{Binding TodayEnergy}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,1" />
              <TextBlock Text="Live accumulation" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <!-- SECTION 2: WALL POWER TREND -->
        <GroupBox Header="Wall Power Trend" Grid.Row="1" Margin="0,0,0,6">
          <Grid Margin="4,2,4,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="86" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
              <TextBlock Text="{Binding GraphWindowLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{Binding UpdatedText}" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
            </Grid>

            <controls:TelemetryChart Grid.Row="1" Values="{Binding PowerHistory}" Stroke="{DynamicResource AccentBrush}"
                                    Unit=" W" Minimum="0" />
          </Grid>
        </GroupBox>

        <!-- SECTION 3: POWER BY COMPONENT -->
        <GroupBox Header="Power by Component" Grid.Row="2">
          <Grid Margin="4,2,4,2">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CPU -->
            <Grid Grid.Row="0" Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CPU Package" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CpuTemperature, StringFormat='Temperature: {0}'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding CpuPower}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />

            <!-- GPU -->
            <Grid Grid.Row="1" Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GPU Board" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GpuTemperature, StringFormat='Temperature: {0}'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding GpuPower}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />

            <!-- Storage + Cooling + Board -->
            <Grid Grid.Row="2" Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Storage, Cooling &amp; Board" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="Calibrated hardware model" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding StorageCoolingBoardPower}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="2" VerticalAlignment="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />

            <!-- Displays & Peripherals -->
            <Grid Grid.Row="3" Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Displays &amp; Peripherals" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="Configured hardware model" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding MonitorsPeripheralPower}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </GroupBox>
      </Grid>

      <!-- FOOTER ACTION BAR -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0" CornerRadius="0,0,4,4">
        <Grid Margin="10,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="{Binding PinStatusText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Settings…" Click="Settings_Click" MinWidth="70" Height="24" Margin="0,0,6,0" />
            <Button Content="Open Dashboard" Click="OpenFull_Click" Style="{StaticResource PrimaryButton}" MinWidth="105" Height="24" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
