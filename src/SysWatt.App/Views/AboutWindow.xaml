<Window x:Class="SysWatt.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SysWatt" Width="520" Height="430"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ShowInTaskbar="False"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Grid Margin="16,14,16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header with icon -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="48" Height="48" Margin="0,0,14,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="SysWatt" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
    </StackPanel>

    <!-- Details -->
    <StackPanel Grid.Row="1">
      <TextBlock Text="SysWatt is a lightweight Windows hardware power and energy monitor designed to keep measured telemetry, unavailable readings, and historical consumption clearly separated."
                 TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,0,0,12" />

      <GroupBox Header="Project Information">
        <Grid Margin="0,4,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Developer:" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Ishara (@isharax9)" />

          <TextBlock Grid.Row="2" Text="Repository:" FontWeight="SemiBold" />
          <Button Grid.Row="2" Grid.Column="1" Content="github.com/isharax9/PerfMetrics" Click="Project_Click"
                  HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource AccentBrush}" Cursor="Hand" />

          <TextBlock Grid.Row="4" Text="License:" FontWeight="SemiBold" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="MIT License" />
        </Grid>
      </GroupBox>

      <TextBlock Text="Data Privacy &amp; Local Storage" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,2" />
      <TextBlock Text="Energy history and settings are stored locally in SQLite. SysWatt does not collect or transmit personal telemetry."
                 FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Bottom button -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Button Content="OK" Click="Close_Click" Style="{StaticResource PrimaryButton}"
              Width="80" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</Window>
