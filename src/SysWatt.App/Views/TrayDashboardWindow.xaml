<Window x:Class="SysWatt.App.Views.TrayDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysWatt.App.Controls"
        Title="SysWatt quick dashboard" Width="430" Height="600" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="15,0,9,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="36" Height="36" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="SYSWATT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="15"/><TextBlock Text="{Binding TelemetrySourceBadge}" Foreground="{StaticResource MutedBrush}" FontSize="8"/></StackPanel></StackPanel>
          <ToggleButton x:Name="PinButton" Grid.Column="1" IsChecked="{Binding TrayPopupPinned}" Content="⌖" ToolTip="Pin dashboard so it stays visible" Width="38" Height="34" FontSize="17" Margin="0,0,4,0"/>
          <Button Grid.Column="2" Content="×" Style="{StaticResource WindowControlButton}" Click="Close_Click"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="15">
          <Border Background="#1C2934" BorderBrush="#3D617A" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10" Visibility="{Binding TelemetrySourceNoticeVisibility}"><TextBlock Text="{Binding TelemetrySourceNotice}" Foreground="#B8DFFF" FontSize="9" TextWrapping="Wrap"/></Border>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="#123026" BorderBrush="#2E6652" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="CURRENT WALL DRAW" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding EstimatedWallPower}" FontSize="31" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="{Binding EstimatedDcPower, StringFormat=DC {0}}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="TODAY" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding TodayEnergy}" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,2"/><TextBlock Text="1 unit = 1 kWh" Foreground="{StaticResource AccentBrush}" FontSize="9"/></StackPanel></Border>
          </Grid>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="112"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="POWER TREND" FontWeight="SemiBold" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding UpdatedText}" Foreground="{StaticResource MutedBrush}" FontSize="8"/></Grid><controls:TelemetryChart Grid.Row="1" Values="{Binding PowerHistory}" Stroke="{StaticResource AccentBrush}" Unit=" W" Margin="0,6,0,0"/></Grid>
          </Border>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding CpuUsage}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding CpuTemperature}" Foreground="#63B7FF" FontSize="11"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="GPU" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding GpuUsage}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding GpuTemperature}" Foreground="#A986FF" FontSize="11"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="MEMORY" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding MemoryUsage}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding StorageActivity, StringFormat=Disk {0}}" Foreground="{StaticResource AccentBrush}" FontSize="11"/></StackPanel>
          </Grid>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
            <StackPanel><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="COMPONENT POWER" FontSize="10" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding StoragePower, StringFormat=Storage {0}}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="8"/><TextBlock Text="{Binding CpuPower}" FontSize="17"/><TextBlock Text="{Binding CpuPowerSource}" Foreground="{StaticResource AccentBrush}" FontSize="7"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="GPU" Foreground="{StaticResource MutedBrush}" FontSize="8"/><TextBlock Text="{Binding GpuPower}" FontSize="17"/><TextBlock Text="{Binding GpuPowerSource}" Foreground="{StaticResource AccentBrush}" FontSize="7"/></StackPanel></Grid></StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10"><Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Pin keeps this dashboard visible" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Open full dashboard" Click="OpenFull_Click"/></Grid></Border>
    </Grid>
  </Border>
</Window>
