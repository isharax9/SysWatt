<Window x:Class="SysWatt.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Option Settings" Width="680" Height="560" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Grid Margin="10,8,10,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0" Margin="0,0,0,8">
      <!-- TAB 1: GENERAL SETTINGS -->
      <TabItem Header="General Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="6,4,6,4">
            <GroupBox Header="Appearance and Tray Icon">
              <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Color theme:" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" MaxWidth="220" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="2" Text="Tray metric:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TrayMetricChoices}" SelectedItem="{Binding TrayMetric}" MaxWidth="220" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="4" Text="Graph rolling window (min):" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GraphWindowMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" ToolTip="Live graph history duration: 1–240 minutes" />

                <TextBlock Grid.Row="6" Text="Alert banner duration (sec):" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AlertBannerSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" ToolTip="Notification banner timeout: 3–60 seconds" />
              </Grid>
            </GroupBox>

            <GroupBox Header="Startup and Window Options">
              <StackPanel Margin="0,4,0,4">
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                <CheckBox Content="Start minimized to system tray" IsChecked="{Binding StartMinimized}" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Measurement Policy">
              <TextBlock Text="SysWatt preserves exact hardware sensors (CPU package power, GPU board draw) whenever available. Motherboard, memory, cooling, storage, and peripheral power use the calibrated hardware-informed models configured on the Power Model tab."
                         TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2" />
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- TAB 2: POWER MODEL -->
      <TabItem Header="Power Model">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="6,4,6,4">
            <GroupBox Header="Base System &amp; PSU Efficiency">
              <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Motherboard + RAM:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding BaseWatts, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                <TextBlock Grid.Column="4" Text="PSU efficiency:" VerticalAlignment="Center" />
                <TextBox Grid.Column="5" Text="{Binding EfficiencyPercent, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="6" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />
              </Grid>
            </GroupBox>

            <GroupBox Header="Component Fallback Envelopes (when direct sensors absent)">
              <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="CPU idle fallback:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding CpuIdleWatts, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                <TextBlock Grid.Column="4" Text="CPU peak envelope:" VerticalAlignment="Center" />
                <TextBox Grid.Column="5" Text="{Binding CpuPeakWatts, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="6" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                <TextBlock Grid.Row="2" Text="GPU idle fallback:" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GpuIdleWatts, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                <TextBlock Grid.Row="2" Grid.Column="4" Text="GPU peak envelope:" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding GpuPeakWatts, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="6" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />
              </Grid>
            </GroupBox>

            <GroupBox Header="Storage Power">
              <StackPanel Margin="0,4,0,4">
                <CheckBox Content="Detect NVMe, SSD, and HDD devices automatically" IsChecked="{Binding AutoDetectStorage}" Margin="0,0,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Minimum drives:" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding StorageDeviceCount, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="#" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Column="4" Text="Active-power ceiling:" VerticalAlignment="Center" />
                  <TextBox Grid.Column="5" Text="{Binding StorageWatts, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="6" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Row="2" Text="Idle watts / device:" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StorageIdleWattsPerDevice, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Row="2" Grid.Column="4" Text="Throughput ceiling:" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding StorageThroughputCeilingMBps, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="2" Grid.Column="6" Text="MB/s" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Displays &amp; Peripherals">
              <StackPanel Margin="0,4,0,4">
                <CheckBox Content="Detect active displays automatically" IsChecked="{Binding AutoDetectDisplays}" />
                <Grid Margin="0,4,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Display count:" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding DisplayCount, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="#" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Column="4" Text="Watts / display:" VerticalAlignment="Center" />
                  <TextBox Grid.Column="5" Text="{Binding DisplayWatts, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="6" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
                <TextBlock Text="{Binding DisplayPowerPreview}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />

                <CheckBox Content="Detect cameras and removable devices" IsChecked="{Binding AutoDetectRemovablePeripherals}" />
                <Grid Margin="0,4,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="USB device load:" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding UsbPeripheralWatts, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Column="4" Text="External peripherals:" VerticalAlignment="Center" />
                  <TextBox Grid.Column="5" Text="{Binding ExternalPeripheralWatts, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="6" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Row="2" Text="Other wall loads:" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OtherWallWatts, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Row="2" Grid.Column="4" Text="Watts / detected device:" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding WattsPerDetectedPeripheral, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="2" Grid.Column="6" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- TAB 3: COOLING & INVENTORY -->
      <TabItem Header="Cooling &amp; Inventory">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="6,4,6,4">
            <GroupBox Header="Cooling Power Inventory">
              <StackPanel Margin="0,4,0,4">
                <CheckBox Content="Use detected motherboard cooling headers as a minimum" IsChecked="{Binding AutoDetectCooling}" Margin="0,0,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Text="CPU cooler fans:" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding CpuCoolerFanCount, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="#" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Column="4" Text="Rated watts / fan:" VerticalAlignment="Center" />
                  <TextBox Grid.Column="5" Text="{Binding WattsPerFan, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: 12V × 0.2A = 2.4W" />
                  <TextBlock Grid.Column="6" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Row="2" Text="Case / radiator fans:" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CaseFanCount, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="#" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />

                  <TextBlock Grid.Row="2" Grid.Column="4" Text="Pumps / controllers:" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding OtherCoolingWatts, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="2" Grid.Column="6" Text="W" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
                <TextBlock Text="{Binding CoolingRatedPower}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Cooling Explanation">
              <TextBlock Text="Firmware fan headers report active RPM when connected directly. Splitters and unreported case fans still need the manual count above. GPU fans are already included in GPU board power and are never double-counted."
                         TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2" />
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- TAB 4: ALERT RULES -->
      <TabItem Header="Alert Rules">
        <Grid Margin="6,4,6,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <GroupBox Header="Custom Alert Rules" Grid.Row="0">
            <DataGrid ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="ON" Width="36">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" Margin="0" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rule Name" Binding="{Binding Name}" Width="1.4*" />
                <DataGridTemplateColumn Header="Metric" Width="140">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><ComboBox ItemsSource="{Binding MetricChoices}" SelectedItem="{Binding Metric}" Height="22" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Op" Width="55">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><ComboBox ItemsSource="{Binding OperatorChoices}" SelectedItem="{Binding Operator}" Height="22" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Value" Binding="{Binding Threshold}" Width="55" />
                <DataGridTextColumn Header="For (s)" Binding="{Binding DurationSeconds}" Width="55" />
                <DataGridTextColumn Header="Cooldown" Binding="{Binding CooldownSeconds}" Width="65" />
                <DataGridTemplateColumn Header="Severity" Width="85">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><ComboBox ItemsSource="{Binding SeverityChoices}" SelectedItem="{Binding Severity}" Height="22" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Toast" Width="45">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding DesktopNotification}" HorizontalAlignment="Center" Margin="0" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="In-App" Width="48">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding InApp}" HorizontalAlignment="Center" Margin="0" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Add rule" Command="{Binding AddAlertCommand}" Margin="0,0,6,0" />
            <Button Content="Duplicate" Command="{Binding DuplicateAlertCommand}" Margin="0,0,6,0" />
            <Button Content="Delete" Command="{Binding DeleteAlertCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- BOTTOM ACTION BAR -->
    <Grid Grid.Row="1" Height="28" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Export diagnostics…" Click="ExportDiagnostics_Click" Margin="0,0,8,0" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="OK" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0" />
        <Button Content="Apply" Command="{Binding ApplyCommand}" Margin="6,0,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
