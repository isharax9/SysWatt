<Window x:Class="SysWatt.App.Views.TrayDashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SysWatt.App.Controls" Title="SysWatt quick dashboard" Width="430" Height="584" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Window.Resources>
    <Style x:Key="FriendlyPinButton" TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SuccessSurfaceBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="15,0,9,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="35" Height="35" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="SYSWATT" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="15"/><TextBlock Text="POWER INTELLIGENCE" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel></StackPanel><ToggleButton Grid.Column="1" IsChecked="{Binding TrayPopupPinned}" Content="{Binding PinButtonText}" ToolTip="Click to switch whether this dashboard stays open" Style="{StaticResource FriendlyPinButton}" Margin="0,0,5,0"/><Button Grid.Column="2" Content="×" Style="{StaticResource WindowControlButton}" Click="Close_Click"/></Grid></Border>
      <Grid Grid.Row="1" Margin="15,13,15,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="138"/><RowDefinition Height="10"/><RowDefinition Height="70"/><RowDefinition Height="10"/><RowDefinition Height="100"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="13"><StackPanel><TextBlock Text="CURRENT WALL DRAW" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding SystemPower}" FontSize="31" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="{Binding DcPower, StringFormat=DC {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="9"/></StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13"><StackPanel><TextBlock Text="TODAY" Foreground="{DynamicResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding TodayEnergy}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="1 unit = 1 kWh" Foreground="{DynamicResource AccentBrush}" FontSize="9"/></StackPanel></Border></Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="POWER TREND" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="{Binding GraphWindowLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding UpdatedText}" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></Grid><controls:TelemetryChart Grid.Row="1" Values="{Binding PowerHistory}" Stroke="{DynamicResource AccentBrush}" Unit=" W" Minimum="0" Margin="0,5,0,0"/></Grid></Border>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}" FontSize="8"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CpuUsage}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding CpuPower}" FontSize="15" VerticalAlignment="Bottom"/></StackPanel><TextBlock Text="{Binding CpuTemperature}" Foreground="#63B7FF" FontSize="10"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="GPU" Foreground="{DynamicResource MutedBrush}" FontSize="8"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding GpuUsage}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding GpuPower}" FontSize="15" VerticalAlignment="Bottom"/></StackPanel><TextBlock Text="{Binding GpuTemperature}" Foreground="#A986FF" FontSize="10"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="MEMORY / DISK" Foreground="{DynamicResource MutedBrush}" FontSize="8"/><TextBlock Text="{Binding MemoryUsage}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding StorageActivity, StringFormat=Disk {0}}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/></StackPanel></Grid>
        <Border Grid.Row="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="POWER BREAKDOWN" FontSize="9" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}" FontSize="7"/><TextBlock Text="{Binding CpuPower}" FontSize="15"/><TextBlock Text="SENSOR / MODEL" Foreground="{DynamicResource AccentBrush}" FontSize="6"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="GPU" Foreground="{DynamicResource MutedBrush}" FontSize="7"/><TextBlock Text="{Binding GpuPower}" FontSize="15"/><TextBlock Text="SENSOR / MODEL" Foreground="{DynamicResource AccentBrush}" FontSize="6"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="STORAGE + FANS + MB" Foreground="{DynamicResource MutedBrush}" FontSize="6"/><TextBlock Text="{Binding StorageCoolingBoardPower}" FontSize="15"/><TextBlock Text="CALCULATED" Foreground="#E6A34A" FontSize="6"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="MONITORS + PERIPHERALS" Foreground="{DynamicResource MutedBrush}" FontSize="6"/><TextBlock Text="{Binding MonitorsPeripheralPower}" FontSize="15"/><TextBlock Text="CALCULATED" Foreground="#E6A34A" FontSize="6"/></StackPanel></Grid></Grid></Border>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10"><Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PinStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Open dashboard" Click="OpenFull_Click" Padding="13,7"/></Grid></Border>
    </Grid>
  </Border>
</Window>
