<Window x:Class="SysWatt.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysWatt Settings" Width="900" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="SETTINGS" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="220"/><ColumnDefinition Width="25"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="Tray metric" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding TrayMetricChoices}" SelectedItem="{Binding TrayMetric}" Padding="5"/>
      <TextBlock Grid.Column="3" Text="Base system consumption" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="4" Orientation="Horizontal"><TextBox Text="{Binding BaseWatts, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="5"/><TextBlock Text=" W" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="220"/><ColumnDefinition Width="25"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Foreground="White"/>
        <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" Foreground="White" Margin="0,8,0,0"/>
      </StackPanel>
      <TextBlock Grid.Column="3" Text="PSU efficiency" VerticalAlignment="Top"/>
      <StackPanel Grid.Column="4"><StackPanel Orientation="Horizontal"><TextBox Text="{Binding EfficiencyPercent, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="5"/><TextBlock Text=" %" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></StackPanel><TextBlock Text="Wall estimate = DC load / efficiency" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
    </Grid>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="CUSTOM ALERTS" FontWeight="SemiBold"/><TextBlock Text="Missing and stale sensor values never trigger alerts." Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Add" Command="{Binding AddAlertCommand}" Margin="4"/><Button Content="Duplicate" Command="{Binding DuplicateAlertCommand}" Margin="4"/><Button Content="Delete" Command="{Binding DeleteAlertCommand}" Margin="4"/></StackPanel>
      </Grid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" AutoGenerateColumns="False"
                CanUserAddRows="False" HeadersVisibility="Column" Margin="0,10,0,12" Background="#171D22" Foreground="White"
                RowBackground="#171D22" AlternatingRowBackground="#1D252B" GridLinesVisibility="Horizontal" BorderBrush="#34414A">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="38"/>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130"/>
          <DataGridTemplateColumn Header="Metric" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding MetricChoices}" SelectedItem="{Binding Metric}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Operator" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding OperatorChoices}" SelectedItem="{Binding Operator}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Value" Binding="{Binding Threshold}" Width="65"/>
          <DataGridTextColumn Header="For (s)" Binding="{Binding DurationSeconds}" Width="65"/>
          <DataGridTextColumn Header="Cooldown (s)" Binding="{Binding CooldownSeconds}" Width="85"/>
          <DataGridTemplateColumn Header="Severity" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding SeverityChoices}" SelectedItem="{Binding Severity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridCheckBoxColumn Header="Toast" Binding="{Binding DesktopNotification}" Width="50"/>
          <DataGridCheckBoxColumn Header="In app" Binding="{Binding InApp}" Width="52"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Error}" Foreground="#FF827A" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Export diagnostics…" Click="ExportDiagnostics_Click" Margin="4"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="4"/><Button Content="Save settings" Command="{Binding SaveCommand}" Background="#28775B" Margin="4"/></StackPanel>
    </Grid>
  </Grid>
</Window>
