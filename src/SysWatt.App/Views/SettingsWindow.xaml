<Window x:Class="SysWatt.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysWatt Settings" Width="1180" Height="780" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="CanResize" Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Background="{StaticResource WindowBackground}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="66" />
        <RowDefinition Height="*" />
        <RowDefinition Height="72" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="20,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,13,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="SysWatt Settings" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Monitoring, power model, and alert preferences" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Content="×" Style="{StaticResource WindowControlButton}" Click="Close_Click" ToolTip="Close" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="24,20,24,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.28*"/></Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource SettingsCard}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="TRAY &amp; STARTUP" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
              <Grid Grid.Row="1" Margin="0,13,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Tray metric" FontWeight="SemiBold" />
                  <TextBlock Text="Value shown in the taskbar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding TrayMetricChoices}" SelectedItem="{Binding TrayMetric}" MinWidth="220" />
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal">
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,26,0" />
                <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource SettingsCard}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="POWER MODEL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
              <TextBlock Grid.Row="1" Text="PC loads are counted before PSU loss; displays and external devices are added at the wall." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,9" TextWrapping="Wrap" />
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/><ColumnDefinition Width="74"/><ColumnDefinition Width="24"/><ColumnDefinition Width="16"/>
                  <ColumnDefinition/><ColumnDefinition Width="74"/><ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Motherboard + RAM" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding BaseWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="CPU idle model" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Text="{Binding CpuIdleWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Column="6" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="CPU peak / TDP model" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CpuPeakWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="GPU idle model" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding GpuIdleWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="6" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Text="GPU peak / board model" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GpuPeakWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Storage device count" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding StorageDeviceCount, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="2" Grid.Column="6" Text="#" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Text="Storage active ceiling" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StorageWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2" ToolTip="Total storage draw when activity or throughput reaches the configured ceiling."/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="4" Text="Storage idle / device" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="5" Text="{Binding StorageIdleWattsPerDevice, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="3" Grid.Column="6" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="4" Text="Storage throughput ceiling" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StorageThroughputCeilingMBps, UpdateSourceTrigger=PropertyChanged}" Margin="5,2" ToolTip="Approximate combined read/write rate where drives are considered fully active."/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="MB/s" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="4" Text="Regular fan count" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="5" Text="{Binding FanCount, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="4" Grid.Column="6" Text="#" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="5" Text="Rated watts per fan" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WattsPerFan, UpdateSourceTrigger=PropertyChanged}" Margin="5,2" ToolTip="Use 12 × the fan label's rated amps."/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="4" Text="Other cooling / pumps" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="5" Text="{Binding OtherCoolingWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="5" Grid.Column="6" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="6" Text="USB-powered devices" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding UsbPeripheralWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="6" Grid.Column="4" Text="PSU efficiency" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="5" Text="{Binding EfficiencyPercent, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="6" Grid.Column="6" Text="%" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="7" Text="Displays at wall" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding DisplayWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="7" Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="7" Grid.Column="4" Text="External peripherals" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="7" Grid.Column="5" Text="{Binding ExternalPeripheralWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="7" Grid.Column="6" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="8" Text="Other wall loads" FontSize="10" VerticalAlignment="Center"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding OtherWallWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="8" Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,0,2,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CUSTOM ALERTS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Rules evaluate normalized live metrics. Missing or stale readings never trigger." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Add rule" Command="{Binding AddAlertCommand}" Margin="0,0,8,0" />
            <Button Content="Duplicate" Command="{Binding DuplicateAlertCommand}" Margin="0,0,8,0" />
            <Button Content="Delete" Command="{Binding DeleteAlertCommand}" />
          </StackPanel>
        </Grid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" AlternationCount="2" FrozenColumnCount="2">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="ON" Width="44">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="RULE NAME" Binding="{Binding Name}" Width="1.25*" MinWidth="145" />
            <DataGridTemplateColumn Header="METRIC" Width="155">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding MetricChoices}" SelectedItem="{Binding Metric}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="OPERATOR" Width="84">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding OperatorChoices}" SelectedItem="{Binding Operator}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="VALUE" Binding="{Binding Threshold}" Width="70" />
            <DataGridTextColumn Header="FOR (S)" Binding="{Binding DurationSeconds}" Width="72" />
            <DataGridTextColumn Header="COOLDOWN" Binding="{Binding CooldownSeconds}" Width="88" />
            <DataGridTemplateColumn Header="SEVERITY" Width="100">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding SeverityChoices}" SelectedItem="{Binding Severity}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="TOAST" Width="58">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding DesktopNotification}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="IN APP" Width="62">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding InApp}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Export diagnostics…" Click="ExportDiagnostics_Click" Margin="0,0,10,0" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
            <Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
