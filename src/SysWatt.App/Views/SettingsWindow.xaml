<Window x:Class="SysWatt.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SysWatt Settings" Width="1120" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="CanResize" Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Background="{DynamicResource WindowBackground}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="20,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,13,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Appearance, startup, cooling inventory, and alert policy" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Content="×" Style="{StaticResource WindowControlButton}" Click="Close_Click" ToolTip="Close"/></Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,22,24,26">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsCard}"><StackPanel>
              <TextBlock Text="APPEARANCE &amp; STARTUP" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
              <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Color theme" FontWeight="SemiBold"/><TextBlock Text="Applied to dashboard and tray popup" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" MinWidth="200"/>
                <StackPanel Grid.Row="2"><TextBlock Text="Tray metric" FontWeight="SemiBold"/><TextBlock Text="Hardware reading rendered in tray icon" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TrayMetricChoices}" SelectedItem="{Binding TrayMetric}" MinWidth="200"/>
                <StackPanel Grid.Row="4"><TextBlock Text="Graph rolling window" FontWeight="SemiBold"/><TextBlock Text="Custom live duration: 1–240 minutes" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GraphWindowMinutes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minutes retained in every live dashboard graph"/>
                <StackPanel Grid.Row="6"><TextBlock Text="Alert banner duration" FontWeight="SemiBold"/><TextBlock Text="Automatically clears: 3–60 seconds" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AlertBannerSeconds, UpdateSourceTrigger=PropertyChanged}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,28,0"/><CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}"/></StackPanel>
            </StackPanel></Border>

            <Border Grid.Column="2" Style="{StaticResource SettingsCard}"><StackPanel>
              <TextBlock Text="COOLING POWER INVENTORY" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="CPU/case fan headers are detected when firmware exposes them. Splitters and unreported fans still need this manual count; GPU fans are already included in GPU board power." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,14"/>
              <CheckBox Content="Use detected cooling headers as a minimum" IsChecked="{Binding AutoDetectCooling}" Margin="0,0,0,9"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/><ColumnDefinition Width="34"/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="88"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="CPU air-cooler fans" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CpuCoolerFanCount, UpdateSourceTrigger=PropertyChanged}" Margin="5,3"/><TextBlock Grid.Column="2" Text="#" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Rated watts / fan" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding WattsPerFan, UpdateSourceTrigger=PropertyChanged}" Margin="5,3" ToolTip="Use label voltage × rated current. Example: 12 V × 0.20 A = 2.4 W."/><TextBlock Grid.Column="6" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="Case / radiator fans" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CaseFanCount, UpdateSourceTrigger=PropertyChanged}" Margin="5,3"/><TextBlock Grid.Row="1" Grid.Column="2" Text="#" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Pumps / hubs / controllers" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="5" Text="{Binding OtherCoolingWatts, UpdateSourceTrigger=PropertyChanged}" Margin="5,3"/><TextBlock Grid.Row="1" Grid.Column="6" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3" Margin="5,7,0,0"><TextBlock Text="RATED MAXIMUM" Foreground="{DynamicResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding CoolingRatedPower}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
              </Grid>
            </StackPanel></Border>
          </Grid>

          <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,0"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="POWER ESTIMATION" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Measured CPU and GPU power is preferred. These settings cover components that cannot report power directly." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="5" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="ALL VALUES ARE ADJUSTABLE" Foreground="{DynamicResource AccentBrush}" FontSize="8" FontWeight="Bold"/></Border>
            </Grid>
            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel>
                <TextBlock Text="SYSTEM COMPONENTS" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Fallback ranges are used only when an exact sensor is unavailable." Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,8"/>
                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="Motherboard + RAM" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding BaseWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="PSU efficiency" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding EfficiencyPercent, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="%" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,5"/>
                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="CPU idle fallback" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CpuIdleWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="CPU peak envelope" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CpuPeakWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="GPU idle fallback" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding GpuIdleWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="GPU peak envelope" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding GpuPeakWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
              </StackPanel></Border>
              <Border Grid.Column="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel>
                <TextBlock Text="STORAGE" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Drive type and live activity shape the calculated storage load." Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,8"/>
                <CheckBox Content="Detect NVMe, SSD, and HDD devices" IsChecked="{Binding AutoDetectStorage}" Margin="0,5,0,8"/>
                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="Minimum device count" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding StorageDeviceCount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="#" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="Active-power ceiling" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding StorageWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="Idle watts per device" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding StorageIdleWattsPerDevice, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="Throughput ceiling" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding StorageThroughputCeilingMBps, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="MB/s" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
              </StackPanel></Border>
              <Border Grid.Column="4" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel>
                <TextBlock Text="DISPLAYS &amp; EXTERNAL POWER" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="These loads are added after PSU losses because they draw power separately." Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,8"/>
                <CheckBox Content="Detect active displays" IsChecked="{Binding AutoDetectDisplays}" Margin="0,5,0,7"/>
                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="Minimum display count" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding DisplayCount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="#" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="Watts per display" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding DisplayWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Border Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,8,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Configured display load" Foreground="{DynamicResource MutedBrush}" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding DisplayPowerPreview}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Grid></Border>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="USB device load" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding UsbPeripheralWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="External peripherals" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ExternalPeripheralWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="Other wall loads" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding OtherWallWatts, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                <CheckBox Content="Detect cameras and portable devices" IsChecked="{Binding AutoDetectRemovablePeripherals}" Margin="0,10,0,0"/>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="Watts per detected device" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding WattsPerDetectedPeripheral, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="W" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
              </StackPanel></Border>
            </Grid>
          </StackPanel></Border>

          <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,20" Padding="18,13">
            <StackPanel>
              <TextBlock Text="MEASUREMENT POLICY" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
              <TextBlock Text="Exact CPU and GPU sensors are used whenever available. All other component values are clearly marked as calculated estimates." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>

          <Grid Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CUSTOM ALERTS" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Rules evaluate live measured metrics. Missing or stale readings never trigger." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Add rule" Command="{Binding AddAlertCommand}" Margin="0,0,8,0"/><Button Content="Duplicate" Command="{Binding DuplicateAlertCommand}" Margin="0,0,8,0"/><Button Content="Delete" Command="{Binding DeleteAlertCommand}"/></StackPanel></Grid>
          <DataGrid ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" AlternationCount="2" MinHeight="260">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ON" Width="44"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="RULE NAME" Binding="{Binding Name}" Width="1.25*" MinWidth="145"/>
              <DataGridTemplateColumn Header="METRIC" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding MetricChoices}" SelectedItem="{Binding Metric}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="OPERATOR" Width="84"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding OperatorChoices}" SelectedItem="{Binding Operator}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="VALUE" Binding="{Binding Threshold}" Width="70"/><DataGridTextColumn Header="FOR (S)" Binding="{Binding DurationSeconds}" Width="72"/><DataGridTextColumn Header="COOLDOWN" Binding="{Binding CooldownSeconds}" Width="88"/>
              <DataGridTemplateColumn Header="SEVERITY" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding SeverityChoices}" SelectedItem="{Binding Severity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="TOAST" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding DesktopNotification}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="IN APP" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding InApp}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Export diagnostics…" Click="ExportDiagnostics_Click" Margin="0,0,10,0"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0"/><Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid></Border>
    </Grid>
  </Border>
</Window>
