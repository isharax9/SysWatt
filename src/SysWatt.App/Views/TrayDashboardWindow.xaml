<Window x:Class="SysWatt.App.Views.TrayDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysWatt.App.Controls"
        Title="SysWatt quick dashboard" Width="430" Height="584" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Window.Resources>
    <Style x:Key="FriendlyPinButton" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/>
      <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SuccessSurfaceBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ComponentRow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="0,8"/>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="15,0,9,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="35" Height="35" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="SYSWATT" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="15"/><TextBlock Text="LIVE POWER MONITOR" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel></StackPanel>
          <ToggleButton Grid.Column="1" IsChecked="{Binding TrayPopupPinned}" Content="{Binding PinButtonText}" ToolTip="Click to switch whether this dashboard stays open" Style="{StaticResource FriendlyPinButton}" Margin="0,0,5,0"/>
          <Button Grid.Column="2" Content="×" Style="{StaticResource WindowControlButton}" Click="Close_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="15,13,15,12">
        <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="10"/><RowDefinition Height="126"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="LIVE WALL POWER" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding SystemPower}" FontSize="38" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Power drawn from the wall" Foreground="{DynamicResource MutedBrush}" FontSize="9"/></StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="TODAY'S ENERGY" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding TodayEnergy}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,1"/><TextBlock Text="1 unit = 1 kWh" Foreground="{DynamicResource AccentBrush}" FontSize="8"/></StackPanel></Border>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WALL-POWER TREND" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="{Binding GraphWindowLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding UpdatedText}" Foreground="{DynamicResource MutedBrush}" FontSize="8" VerticalAlignment="Top"/></Grid>
            <controls:TelemetryChart Grid.Row="1" Values="{Binding PowerHistory}" Stroke="{DynamicResource AccentBrush}" Unit=" W" Minimum="0" Margin="0,5,0,0"/>
          </Grid>
        </Border>
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="POWER BY COMPONENT" FontSize="9" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="CURRENT DRAW" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></Grid>
            <Border Grid.Row="1" Style="{StaticResource ComponentRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#63B7FF" CornerRadius="2" Margin="0,1,9,1"/><StackPanel Grid.Column="1"><TextBlock Text="CPU PACKAGE" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding CpuTemperature, StringFormat=Temperature {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding CpuPower}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
            <Border Grid.Row="2" Style="{StaticResource ComponentRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#A986FF" CornerRadius="2" Margin="0,1,9,1"/><StackPanel Grid.Column="1"><TextBlock Text="GPU BOARD" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding GpuTemperature, StringFormat=Temperature {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding GpuPower}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
            <Border Grid.Row="3" Style="{StaticResource ComponentRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#E6A34A" CornerRadius="2" Margin="0,1,9,1"/><StackPanel Grid.Column="1"><TextBlock Text="STORAGE, COOLING &amp; BOARD" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Calculated estimate" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding StorageCoolingBoardPower}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
            <Border Grid.Row="4" Style="{StaticResource ComponentRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#E6A34A" CornerRadius="2" Margin="0,1,9,1"/><StackPanel Grid.Column="1"><TextBlock Text="DISPLAYS &amp; PERIPHERALS" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Calculated estimate" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding MonitorsPeripheralPower}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
        <Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PinStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Open dashboard" Click="OpenFull_Click" Padding="13,7"/></Grid>
      </Border>
    </Grid>
  </Border>
</Window>
