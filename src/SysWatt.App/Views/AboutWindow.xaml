<Window x:Class="SysWatt.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SysWatt" Width="560" Height="500"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ShowInTaskbar="False"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Grid Background="{DynamicResource WindowBackground}">
    <DockPanel Margin="16,14,16,14">
      <!-- Bottom Action Bar (always visible) -->
      <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Bug Report feature -->
        <Button Content="🐛 Report a Bug / Issue" Click="ReportBug_Click" MinWidth="160" Height="26" HorizontalAlignment="Left" />

        <Button Grid.Column="1" Content="OK" Click="Close_Click" Style="{StaticResource PrimaryButton}"
                Width="80" Height="26" HorizontalAlignment="Right" />
      </Grid>

      <!-- Header with icon -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
        <Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="44" Height="44" Margin="0,0,12,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SysWatt" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding Version, StringFormat=Version {0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </StackPanel>

      <!-- Details Content -->
      <StackPanel>
        <TextBlock Text="SysWatt is a lightweight Windows hardware power and energy monitor designed to keep measured telemetry, unavailable readings, and historical consumption clearly separated."
                   TextWrapping="Wrap" FontSize="12" LineHeight="17" Margin="0,0,0,10" />

        <!-- Project Info -->
        <GroupBox Header="Project Information" Margin="0,0,0,10">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="6" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="6" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Developer:" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Ishara Lakshitha (@isharax9)" />

            <TextBlock Grid.Row="2" Text="Repository:" FontWeight="SemiBold" />
            <Button Grid.Row="2" Grid.Column="1" Content="github.com/isharax9/PerfMetrics" Click="Project_Click"
                    HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource AccentBrush}" Cursor="Hand" />

            <TextBlock Grid.Row="4" Text="License:" FontWeight="SemiBold" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="MIT License" />
          </Grid>
        </GroupBox>

        <!-- Developer Connect Profiles -->
        <GroupBox Header="Connect &amp; Social" Margin="0,0,0,10">
          <WrapPanel Margin="0,4,0,2">
            <Button Content="LinkedIn" Click="Url_Click" Tag="https://www.linkedin.com/in/isharax9/" MinWidth="80" Height="24" FontSize="11" Margin="0,0,6,4" />
            <Button Content="Twitter / X" Click="Url_Click" Tag="https://twitter.com/isharax9" MinWidth="80" Height="24" FontSize="11" Margin="0,0,6,4" />
            <Button Content="Email" Click="Url_Click" Tag="mailto:isharax9@gmail.com" MinWidth="80" Height="24" FontSize="11" Margin="0,0,6,4" />
            <Button Content="☕ Buy Me A Coffee" Click="Url_Click" Tag="https://www.buymeacoffee.com/macstudyroom" MinWidth="120" Height="24" FontSize="11" Margin="0,0,6,4" />
            <Button Content="Instagram" Click="Url_Click" Tag="https://www.instagram.com/mac_knight141/" MinWidth="80" Height="24" FontSize="11" Margin="0,0,6,4" />
          </WrapPanel>
        </GroupBox>

        <TextBlock Text="Data Privacy &amp; Local Storage" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,2" />
        <TextBlock Text="Energy history and settings are stored locally in SQLite. SysWatt does not collect or transmit personal telemetry."
                   FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
