<Window x:Class="SysWatt.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="clr-namespace:SysWatt.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SysWatt — Power &amp; Energy Monitor" Width="1360" Height="900" MinWidth="1100" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" ShowInTaskbar="True"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource SectionCard}">
      <Setter Property="Padding" Value="17"/><Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontWeight" Value="Normal"/>
      <Style.Triggers><Trigger Property="Tag" Value="Selected"><Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>

  <Border x:Name="WindowFrame" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Background="{DynamicResource WindowBackground}">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="14,0"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"><Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="44" Height="44" Margin="0,0,11,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="SYSWATT" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold"/><TextBlock Text="POWER INTELLIGENCE" Foreground="{DynamicResource MutedBrush}" FontSize="9"/></StackPanel></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" Margin="12,0,0,9"/>
            <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Content="▦   Dashboard" Tag="Selected" Click="Navigation_Click" CommandParameter="Dashboard"/>
            <Button x:Name="PerformanceNav" Style="{StaticResource NavButton}" Content="⌁   Performance" Click="Navigation_Click" CommandParameter="Performance"/>
            <Button x:Name="StorageNav" Style="{StaticResource NavButton}" Content="▰   Storage" Click="Navigation_Click" CommandParameter="Storage"/>
            <Button x:Name="CoolingNav" Style="{StaticResource NavButton}" Content="◉   Cooling" Click="Navigation_Click" CommandParameter="Cooling"/>
            <Button x:Name="EnergyNav" Style="{StaticResource NavButton}" Content="⚡   Energy history" Click="Navigation_Click" CommandParameter="Energy"/>
            <Separator Margin="8,14" Background="{DynamicResource BorderBrush}"/>
            <Button Style="{StaticResource NavButton}" Content="⚙   Settings" Click="Settings_Click"/>
            <Button Style="{StaticResource NavButton}" Content="ⓘ   About SysWatt" Click="About_Click"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <Border Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="COLLECTOR STATUS" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding TelemetrySourceBadge}" Margin="0,8,0,0" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding TelemetrySourceDetails}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <TextBlock Text="Exact sensors are preserved; calculated values are labeled." Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="4,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="24,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Power &amp; energy dashboard" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Exact hardware telemetry plus an adjustable hardware-informed wall-power model" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><Border Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="5" Padding="8,5" Margin="0,0,9,0"><TextBlock Text="{Binding TelemetrySourceBadge}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/></Border><TextBlock Text="{Binding UpdatedText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><Button Content="{Binding ThemeAction}" Margin="16,0,0,0" Click="Theme_Click"/><Button x:Name="CustomizeButton" Content="Customize" Margin="8,0,0,0" Click="Customize_Click"/></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="—" Style="{StaticResource WindowControlButton}" Click="Minimize_Click"/><Button Content="□" Style="{StaticResource WindowControlButton}" Click="Maximize_Click"/><Button Content="×" Style="{StaticResource WindowControlButton}" Click="Close_Click"/></StackPanel>
          </Grid>
        </Border>

        <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,22,24,34">
            <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,12" Visibility="{Binding SensorAccessVisibility}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HARDWARE ACCESS NEEDS ATTENTION" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding SensorAccessNotice}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,18,0"/></StackPanel><Button Grid.Column="1" Content="Restart as administrator" Click="RestartElevated_Click" VerticalAlignment="Center"/></Grid></Border>
            <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12" Visibility="{Binding AlertVisibility}"><TextBlock Text="{Binding ActiveAlert}"/></Border>
            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12" Visibility="{Binding TelemetrySourceNoticeVisibility}"><TextBlock Text="{Binding TelemetrySourceNotice}" FontSize="10" TextWrapping="Wrap"/></Border>

            <StackPanel x:Name="DashboardSection" Visibility="{Binding SystemOverviewVisibility}">
              <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource KpiCard}"><StackPanel><TextBlock Text="CURRENT WALL POWER DRAW" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SystemPower}" FontSize="31" FontWeight="Bold" Margin="0,7,0,1"/><TextBlock Text="{Binding DcPower, StringFormat=PC DC {0}}" Foreground="{DynamicResource AccentBrush}" FontSize="9"/><TextBlock Text="{Binding SystemPowerStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding SystemPowerStatus}" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource KpiCard}"><StackPanel><TextBlock Text="STORAGE + FANS + MOTHERBOARD" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding StorageCoolingBoardPower}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="DETECTED + MANUALLY ADJUSTABLE" Foreground="#E6A34A" FontSize="9"/><TextBlock Text="Storage activity, board/RAM, CPU and case cooling" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource KpiCard}"><StackPanel><TextBlock Text="CPU PACKAGE" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,2"><TextBlock Text="{Binding CpuPower}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding CpuTemperature}" FontSize="15" Margin="14,8,0,0" Foreground="#3C91E6"/></StackPanel><TextBlock Text="{Binding CpuUsage, StringFormat=Utilization {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border>
                <Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="TODAY'S ENERGY" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding TodayEnergy}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="1 UNIT = 1 kWh" Foreground="{DynamicResource AccentBrush}" FontSize="9"/><TextBlock Text="{Binding EnergyMeasurementNotice}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
              </UniformGrid>
              <Border Style="{StaticResource SectionCard}" Margin="0,0,0,22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Setup wall-power trend" Style="{StaticResource SectionTitle}"/><TextBlock Text="Exact component sensors + detected/manual system loads + PSU loss" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding GraphWindowLabel}" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"/><TextBlock Text="{Binding SystemPower}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Grid><controls:TelemetryChart Grid.Row="1" Values="{Binding PowerHistory}" Stroke="{DynamicResource AccentBrush}" Unit=" W" Minimum="0" Margin="0,12,0,0"/></Grid></Border>
            </StackPanel>

            <StackPanel x:Name="PerformanceSection" Visibility="{Binding PerformanceChartsVisibility}">
              <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Performance correlation" Style="{StaticResource SectionTitle}"/><TextBlock Text="Utilization and power on synchronized dual axes" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding GraphWindowLabel}" Style="{StaticResource Eyebrow}" VerticalAlignment="Bottom"/></Grid>
              <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SectionCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU UTILIZATION + POWER" FontWeight="SemiBold"/><TextBlock Text="Mint: utilization · Blue: package watts" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding CpuUsage}" FontSize="21"/><TextBlock Text="{Binding CpuPower}" FontSize="21" Foreground="#3C91E6" Margin="14,0,0,0"/></StackPanel></Grid><controls:TelemetryChart Grid.Row="1" Values="{Binding CpuUsageHistory}" SecondaryValues="{Binding CpuPowerHistory}" Stroke="{DynamicResource AccentBrush}" SecondaryStroke="#3C91E6" Unit="%" SecondaryUnit=" W" Minimum="0" Maximum="100" SecondaryMinimum="0" Margin="0,12,0,0"/></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource SectionCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GPU UTILIZATION + POWER" FontWeight="SemiBold"/><TextBlock Text="Purple: utilization · Amber: board watts" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding GpuUsage}" FontSize="21"/><TextBlock Text="{Binding GpuPower}" FontSize="21" Foreground="#E6A23C" Margin="14,0,0,0"/></StackPanel></Grid><controls:TelemetryChart Grid.Row="1" Values="{Binding GpuUsageHistory}" SecondaryValues="{Binding GpuPowerHistory}" Stroke="#8B6FE8" SecondaryStroke="#E6A23C" Unit="%" SecondaryUnit=" W" Minimum="0" Maximum="100" SecondaryMinimum="0" Margin="0,12,0,0"/></Grid></Border>
              </Grid>
            </StackPanel>

            <Grid x:Name="StorageSection" Margin="0,0,0,22" Visibility="{Binding StorageVisibility}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource SectionCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Storage activity" Style="{StaticResource SectionTitle}"/><TextBlock Text="Physical-disk active time" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StorageActivity}" FontSize="23"/></Grid><controls:TelemetryChart Grid.Row="1" Values="{Binding StorageActivityHistory}" Stroke="#3C91E6" Unit="%" Minimum="0" Maximum="100" Margin="0,10,0,0"/></Grid></Border>
              <Border Grid.Column="2" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="Storage telemetry" Style="{StaticResource SectionTitle}"/><TextBlock Text="Operating-system activity plus drive sensors" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,17"/><UniformGrid Columns="2" Rows="2"><StackPanel Margin="0,0,10,15"><TextBlock Text="READ" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding StorageReadRate}" FontSize="20" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="0,0,0,15"><TextBlock Text="WRITE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding StorageWriteRate}" FontSize="20" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="DEVICE POWER" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding StoragePower}" FontSize="20" Margin="0,5,0,0"/><TextBlock Text="SENSOR OR CALCULATED" Foreground="#E6A34A" FontSize="8"/></StackPanel><StackPanel><TextBlock Text="DRIVE TEMPERATURE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding StorageTemperature}" FontSize="20" Margin="0,5,0,0"/></StackPanel></UniformGrid></StackPanel></Border>
            </Grid>

            <Border x:Name="CoolingSection" Style="{StaticResource SectionCard}" Margin="0,0,0,22" Visibility="{Binding CoolingVisibility}"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cooling channels" Style="{StaticResource SectionTitle}"/><TextBlock Text="Live RPM grouped by controller and device" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding FanSummary}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="{Binding ZeroRpmFanAction}" Command="{Binding ToggleZeroRpmFansCommand}" Padding="11,6" ToolTip="Hide or show fan channels currently reporting 0 RPM"/></StackPanel></Grid><ItemsControl ItemsSource="{Binding Fans}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="240"/><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Border Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Hardware}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel><ProgressBar Grid.Column="2" Value="{Binding GaugePercent}" Height="6" Margin="18,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceElevatedBrush}" BorderThickness="0"/><TextBlock Grid.Column="3" Text="{Binding Value}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>

            <StackPanel x:Name="EnergySection" Visibility="{Binding EnergyVisibility}">
              <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Energy history" Style="{StaticResource SectionTitle}"/><TextBlock Text="Hybrid wall-power consumption stored locally in SQLite" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Import archive…" Click="ImportEnergy_Click" Margin="0,0,8,0"/><Button Content="Export archive…" Click="ExportEnergy_Click"/></StackPanel></Grid>
              <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12"><TextBlock Text="{Binding EnergyMeasurementNotice}" FontSize="10" TextWrapping="Wrap"/></Border>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SectionCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="30-DAY ENERGY" FontWeight="SemiBold"/><TextBlock Text="Hybrid wall-power integration; empty days contain no valid sampling session" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><StackPanel Margin="0,0,28,0"><TextBlock Text="7 DAYS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding WeekEnergy}" FontSize="17"/></StackPanel><StackPanel><TextBlock Text="THIS MONTH" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding MonthEnergy}" FontSize="17"/></StackPanel></StackPanel></Grid><controls:TelemetryChart Grid.Row="1" Values="{Binding DailyEnergyHistory}" Stroke="#E6A23C" Unit=" kWh" Minimum="0" Margin="0,12,0,0"/><TextBlock Grid.Row="2" Text="Integration pauses across gaps longer than five minutes. Imports replace matching calendar dates to prevent accidental duplication." Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap"/></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource SectionCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Daily calendar" FontWeight="SemiBold"/><Calendar Grid.Row="1" SelectedDate="{Binding SelectedEnergyDate}" DisplayDateEnd="{x:Static sys:DateTime.Today}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="-7,10,-7,8"/><Border Grid.Row="2" Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="SELECTED DAY" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding SelectedDayEnergy}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="{Binding SelectedDayDetails}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap"/></StackPanel></Border></Grid></Border>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Popup x:Name="CustomizePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=CustomizeButton}" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,6,0,0" Width="250"><StackPanel><TextBlock Text="DASHBOARD SECTIONS" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/><CheckBox Content="Power overview" IsChecked="{Binding ShowSystemOverview}" Margin="0,5"/><CheckBox Content="Utilization + power charts" IsChecked="{Binding ShowPerformanceCharts}" Margin="0,5"/><CheckBox Content="Storage telemetry" IsChecked="{Binding ShowStorage}" Margin="0,5"/><CheckBox Content="Cooling channels" IsChecked="{Binding ShowCooling}" Margin="0,5"/><CheckBox Content="Energy history" IsChecked="{Binding ShowEnergy}" Margin="0,5"/><TextBlock Text="Layout preferences are saved automatically." Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border></Popup>
      </Grid>
    </Grid>
  </Border>
</Window>
