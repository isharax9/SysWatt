<Window x:Class="SysWatt.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysWatt Settings" Width="1060" Height="700" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="CanResize" Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Background="{StaticResource WindowBackground}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="66" />
        <RowDefinition Height="*" />
        <RowDefinition Height="72" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="20,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,13,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="SysWatt Settings" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Monitoring, power model, and alert preferences" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Content="×" Style="{StaticResource WindowControlButton}" Click="Close_Click" ToolTip="Close" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="24,20,24,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource SettingsCard}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="TRAY &amp; STARTUP" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
              <Grid Grid.Row="1" Margin="0,13,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Tray metric" FontWeight="SemiBold" />
                  <TextBlock Text="Value shown in the taskbar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding TrayMetricChoices}" SelectedItem="{Binding TrayMetric}" MinWidth="220" />
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal">
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,26,0" />
                <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource SettingsCard}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="POWER MODEL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
              <Grid Grid.Row="1" Margin="0,13,0,11">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Base system consumption" FontWeight="SemiBold" />
                  <TextBlock Text="Unmeasured motherboard, RAM, drives, fans, and lighting" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding BaseWatts, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
                <TextBlock Grid.Column="2" Text="W" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="PSU efficiency" FontWeight="SemiBold" />
                  <TextBlock Text="Estimated wall draw = DC load / efficiency" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding EfficiencyPercent, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
                <TextBlock Grid.Column="2" Text="%" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,0,2,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CUSTOM ALERTS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Rules evaluate normalized live metrics. Missing or stale readings never trigger." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Add rule" Command="{Binding AddAlertCommand}" Margin="0,0,8,0" />
            <Button Content="Duplicate" Command="{Binding DuplicateAlertCommand}" Margin="0,0,8,0" />
            <Button Content="Delete" Command="{Binding DeleteAlertCommand}" />
          </StackPanel>
        </Grid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" AlternationCount="2" FrozenColumnCount="2">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="ON" Width="44">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="RULE NAME" Binding="{Binding Name}" Width="1.25*" MinWidth="145" />
            <DataGridTemplateColumn Header="METRIC" Width="155">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding MetricChoices}" SelectedItem="{Binding Metric}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="OPERATOR" Width="84">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding OperatorChoices}" SelectedItem="{Binding Operator}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="VALUE" Binding="{Binding Threshold}" Width="70" />
            <DataGridTextColumn Header="FOR (S)" Binding="{Binding DurationSeconds}" Width="72" />
            <DataGridTextColumn Header="COOLDOWN" Binding="{Binding CooldownSeconds}" Width="88" />
            <DataGridTemplateColumn Header="SEVERITY" Width="100">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding SeverityChoices}" SelectedItem="{Binding Severity}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="TOAST" Width="58">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding DesktopNotification}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="IN APP" Width="62">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding InApp}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Export diagnostics…" Click="ExportDiagnostics_Click" Margin="0,0,10,0" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
            <Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
