<Window x:Class="SysWatt.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysWatt.App.Controls"
        Title="SysWatt" Width="480" Height="720" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Border Background="{StaticResource WindowBackground}" BorderBrush="#34414A" BorderThickness="1" CornerRadius="10" Padding="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="/SysWatt.App;component/Assets/SysWatt-logo.png" Width="42" Height="42" Margin="0,0,11,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SYSWATT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="19"/>
            <TextBlock Text="REAL-TIME SYSTEM TELEMETRY" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel Grid.Row="1">
        <Border Background="#202A2E" CornerRadius="5" Padding="9" Margin="0,0,0,8" Visibility="{Binding AlertVisibility}">
          <TextBlock Text="{Binding ActiveAlert}" Foreground="#FFB869" TextWrapping="Wrap"/>
        </Border>
        <Border Background="#2A241A" BorderBrush="#59482B" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,10" Visibility="{Binding SensorAccessVisibility}">
          <TextBlock Text="{Binding SensorAccessNotice}" Foreground="#E8C681" FontSize="9" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CPU LOAD" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding CpuUsage}" FontSize="23" FontWeight="SemiBold"/><controls:Sparkline Height="27" Values="{Binding CpuUsageHistory}" Stroke="{StaticResource AccentBrush}"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource MetricCard}" ToolTip="{Binding CpuTemperatureStatus}"><StackPanel><TextBlock Text="CPU TEMP" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding CpuTemperature}" FontSize="23" FontWeight="SemiBold"/><controls:Sparkline Height="27" Values="{Binding CpuTemperatureHistory}" Stroke="#67B7FF"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource MetricCard}" ToolTip="{Binding CpuPowerStatus}"><StackPanel><TextBlock Text="CPU POWER" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding CpuPower}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="HARDWARE SENSOR" Foreground="{StaticResource MutedBrush}" FontSize="8" Margin="0,8,0,0"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GPU LOAD" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding GpuUsage}" FontSize="23" FontWeight="SemiBold"/><controls:Sparkline Height="27" Values="{Binding GpuUsageHistory}" Stroke="{StaticResource AccentBrush}"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GPU TEMP" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding GpuTemperature}" FontSize="23" FontWeight="SemiBold"/><controls:Sparkline Height="27" Values="{Binding GpuTemperatureHistory}" Stroke="#67B7FF"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GPU POWER" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding GpuPower}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="HARDWARE SENSOR" Foreground="{StaticResource MutedBrush}" FontSize="8" Margin="0,8,0,0"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="4" Margin="0,3,0,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding MemoryUsage}" FontSize="16"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="STORAGE ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding StorageActivity}" FontSize="16"/></StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#171F23" BorderBrush="#34414A" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,9,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="FAN SPEEDS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10"/>
              <TextBlock Grid.Column="1" Text="{Binding FanSummary}" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Fans}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="136" Background="#202A2E" CornerRadius="5" Padding="8" Margin="0,0,6,6" ToolTip="{Binding Details}">
                      <StackPanel>
                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="5" Background="#13251F" BorderBrush="#315847" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="45"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="ESTIMATED TOTAL PC POWER" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/>
          <Grid Grid.Row="1" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding EstimatedWallPower}" FontSize="37" FontWeight="Bold"/><TextBlock Text="ESTIMATED WALL DRAW" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding EstimatedDcPower}" FontSize="20"/><TextBlock Text="ESTIMATED DC LOAD" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel>
          </Grid>
          <controls:Sparkline Grid.Row="2" Values="{Binding PowerHistory}" Stroke="{StaticResource AccentBrush}" Margin="0,5"/>
          <TextBlock Grid.Row="3" Text="{Binding EstimateStatus}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <Grid Grid.Row="6" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Five-minute session history · 1 s samples" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Settings" Click="Settings_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
