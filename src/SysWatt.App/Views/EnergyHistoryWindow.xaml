<Window x:Class="SysWatt.App.Views.EnergyHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historical Energy Statistics" Width="720" Height="530" MinWidth="580" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        Icon="/SysWatt.App;component/Assets/SysWatt.ico">
  <Grid Margin="12,10,12,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0" Margin="0,0,0,8">
      <!-- TAB 1: LIST VIEW (Screenshot 2) -->
      <TabItem Header="List View">
        <Grid Margin="4,4,4,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Top filters toolbar -->
          <StackPanel Orientation="Horizontal" Margin="0,2,0,8" VerticalAlignment="Center">
            <TextBlock Text="View type:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ViewTypes}" SelectedItem="{Binding ViewType}" Width="120" Margin="0,0,16,0" />

            <TextBlock Text="Figure view scale:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding FigureScales}" SelectedItem="{Binding FigureScale}" Width="140" />
          </StackPanel>

          <!-- Table with inline figure bar -->
          <DataGrid Grid.Row="1" ItemsSource="{Binding ListItems}" AutoGenerateColumns="False"
                    CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                    HeadersVisibility="Column" HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="130" />
              <DataGridTextColumn Header="On Time" Binding="{Binding OnTimeText}" Width="70" />
              <DataGridTextColumn Header="DC Load" Binding="{Binding DcKwhText}" Width="75" />
              <DataGridTextColumn Header="Total wall" Binding="{Binding WallKwhText}" Width="75" />
              <DataGridTextColumn Header="Avg watts" Binding="{Binding AverageWattsText}" Width="75" />
              <DataGridTemplateColumn Header="Figure" Width="*" MinWidth="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Margin="2,4,12,4" Height="12" Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding FigureStarWidth}" />
                        <ColumnDefinition Width="{Binding FigureRemainingStarWidth}" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="{Binding FigureColor}" CornerRadius="1" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- TAB 2: CALENDAR VIEW (Screenshot 3) -->
      <TabItem Header="Calendar View">
        <Grid Margin="4,4,4,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Navigation controls -->
          <StackPanel Orientation="Horizontal" Margin="0,2,0,8" VerticalAlignment="Center">
            <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="80" Margin="0,0,14,0" />

            <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" Width="65" Margin="0,0,14,0" />

            <Button Content="&lt;" Command="{Binding PreviousMonthCommand}" MinWidth="26" Width="26" Padding="0" Margin="0,0,4,0" ToolTip="Previous month" />
            <Button Content="&gt;" Command="{Binding NextMonthCommand}" MinWidth="26" Width="26" Padding="0" Margin="0,0,4,0" ToolTip="Next month" />
            <Button Content="=" Command="{Binding CurrentMonthCommand}" MinWidth="26" Width="26" Padding="0" ToolTip="Current month" />
          </StackPanel>

          <!-- Calendar matrix and Legend -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>

            <!-- Calendar Grid -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="26" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Day Headers: Sun, Mon, Tue, Wed, Thu, Fri, Sat -->
                <UniformGrid Columns="7">
                  <Border Background="#C0392B"><TextBlock Text="Sun" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                  <Border Background="#2980B9"><TextBlock Text="Mon" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                  <Border Background="#2980B9"><TextBlock Text="Tue" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                  <Border Background="#2980B9"><TextBlock Text="Wed" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                  <Border Background="#2980B9"><TextBlock Text="Thu" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                  <Border Background="#2980B9"><TextBlock Text="Fri" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                  <Border Background="#C0392B"><TextBlock Text="Sat" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                </UniformGrid>

                <!-- 7x6 Day Cells Matrix -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarDays}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.5"
                              Background="{DynamicResource WindowBackground}"
                              ToolTip="{Binding Tooltip}" Cursor="Hand">
                        <Grid Margin="2">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <!-- Day Number -->
                          <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Center" FontSize="10"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Opacity="{Binding IsCurrentMonth, Converter={x:Null}}" />
                          <!-- Usage color tile -->
                          <Border Grid.Row="1" Width="14" Height="14" Margin="0,2,0,0"
                                  Background="{Binding ColorHex}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  CornerRadius="1" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <!-- Legend on the right -->
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
              <TextBlock Text="Legend:" FontWeight="SemiBold" Margin="0,0,0,10" />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="16" Height="14" Background="#0099FF" CornerRadius="1" Margin="0,0,8,0" />
                <TextBlock Text="0~1 kWh" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="16" Height="14" Background="#55B555" CornerRadius="1" Margin="0,0,8,0" />
                <TextBlock Text="1~3 kWh" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="16" Height="14" Background="#F5B800" CornerRadius="1" Margin="0,0,8,0" />
                <TextBlock Text="3~6 kWh" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="16" Height="14" Background="#FF6633" CornerRadius="1" Margin="0,0,8,0" />
                <TextBlock Text="6~12 kWh" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="16" Height="14" Background="#B30000" CornerRadius="1" Margin="0,0,8,0" />
                <TextBlock Text="12 kWh~" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Month Summary line -->
          <TextBlock Grid.Row="2" Text="{Binding MonthSummary}" FontWeight="SemiBold"
                     Margin="0,8,0,0" VerticalAlignment="Center" />
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Bottom Action Bar -->
    <Grid Grid.Row="1" Height="28" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Import archive…" Command="{Binding ImportCommand}" Margin="0,0,6,0" />
        <Button Content="Export archive…" Command="{Binding ExportCommand}" />
      </StackPanel>

      <Button Grid.Column="1" Content="OK" Command="{Binding OkCommand}"
              Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
